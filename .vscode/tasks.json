{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CW3: Maven Compile",
      "type": "shell",
      "command": "mvn",
      "args": [
        "compile"
      ],
      "options": {
        "cwd": "${workspaceFolder}/CW3",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-lic"
          ]
        }
      },
      "group": "build"
    },
    {
      "label": "CW3: Maven Test",
      "type": "shell",
      "command": "mvn",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}/CW3",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-lic"
          ]
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "CW3: Maven Package",
      "type": "shell",
      "command": "mvn",
      "args": [
        "package"
      ],
      "options": {
        "cwd": "${workspaceFolder}/CW3",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-lic"
          ]
        }
      },
      "group": "build"
    },
    {
      "label": "CW3: Maven Clean Test",
      "type": "shell",
      "command": "mvn",
      "args": [
        "clean",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}/CW3",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-lic"
          ]
        }
      },
      "group": "test"
    },
    {
      "label": "CW3: Package Main Implementation Group 22 Zip",
      "type": "shell",
      "command": "mvn",
      "args": [
        "-q",
        "-Pse-implementation-zip",
        "package"
      ],
      "options": {
        "cwd": "${workspaceFolder}/CW3",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-lic"
          ]
        }
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "detail": "Builds CW3SEImplementationGroup22.zip for the main CW3 submission (excluding Task 4 faculty preregistration files)."
    },
    {
      "label": "CW3: Package Task 4 Group 22 Zip",
      "type": "shell",
      "command": "mvn",
        "args": [
        "-q",
        "-Ptask4-code-review-zip",
        "package"
      ],
      "options": {
        "cwd": "${workspaceFolder}/CW3",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-lic"
          ]
        }
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "detail": "Builds CW3SECodeReviewImplementationGroup22.zip for CW3 Task 4."
    }
  ]
}
