{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CW3: Maven Compile",
      "type": "shell",
      "command": "mvn",
      "args": [
        "compile"
      ],
      "options": {
        "cwd": "${workspaceFolder}/CW3"
      },
      "group": "build"
    },
    {
      "label": "CW3: Maven Test",
      "type": "shell",
      "command": "mvn",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}/CW3"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "CW3: Maven Package",
      "type": "shell",
      "command": "mvn",
      "args": [
        "package"
      ],
      "options": {
        "cwd": "${workspaceFolder}/CW3"
      },
      "group": "build"
    },
    {
      "label": "CW3: Maven Clean Test",
      "type": "shell",
      "command": "mvn",
      "args": [
        "clean",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}/CW3"
      },
      "group": "test"
    }
  ]
}
